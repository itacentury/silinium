{
    "folders": [
        {
            "path": "."
        }
    ],
    "settings": {
        "task.autoDetect": "off",
        // IP of the console running an FTP server (e.g. webMAN), used by the deploy tasks.
        "consoleIp": "192.168.1.100",

        "files.exclude": {
            "bin": true,
            "objs": true
        },
        "files.associations": {
            "*.gsc": "c",
            "*.csc": "c",
            "*.mod": "plaintext"
        },
        "files.eol": "\n",

        // build.sh and the deploy tasks need a POSIX shell (Git Bash on Windows).
        "terminal.integrated.defaultProfile.windows": "Git Bash",

        "C_Cpp.default.cStandard": "c99",
        "C_Cpp.default.intelliSenseMode": "gcc-x64",
        "C_Cpp.default.compilerPath": "${env:SCE_PS3_ROOT}/host-win32/ppu/bin/ppu-lv2-gcc.exe",
        "C_Cpp.default.includePath": [
            "${workspaceFolder}/src",
            "${env:SCE_PS3_ROOT}/target/ppu/include",
            "${env:SCE_PS3_ROOT}/target/common/include",
            "${env:SCE_PS3_ROOT}/host-win32/ppu/lib/gcc/ppu-lv2/4.1.1/include"
        ],
        "C_Cpp.default.defines": [
            "__PPU__",
            "__CELLOS_LV2__"
        ],
        "C_Cpp.errorSquiggles": "disabled"
    },
    "tasks": {
        "version": "2.0.0",
        "options": {
            "cwd": "${workspaceFolder}"
        },
        "tasks": [
            {
                "label": "Build Debug",
                "type": "shell",
                "command": "bash ./build.sh debug",
                "problemMatcher": {
                    "base": "$gcc",
                    "fileLocation": ["relative", "${workspaceFolder}"]
                },
                "group": "build"
            },
            {
                "label": "Build Release",
                "type": "shell",
                "command": "bash ./build.sh release",
                "problemMatcher": {
                    "base": "$gcc",
                    "fileLocation": ["relative", "${workspaceFolder}"]
                },
                "group": "build"
            },
            {
                // Also signs bin/<config>/Silinium_hen.sprx, needs scetool (SCETOOL or PATH).
                "label": "Build Debug (HEN)",
                "type": "shell",
                "command": "bash ./build.sh debug hen",
                "problemMatcher": {
                    "base": "$gcc",
                    "fileLocation": ["relative", "${workspaceFolder}"]
                },
                "group": "build"
            },
            {
                "label": "Build Release (HEN)",
                "type": "shell",
                "command": "bash ./build.sh release hen",
                "problemMatcher": {
                    "base": "$gcc",
                    "fileLocation": ["relative", "${workspaceFolder}"]
                },
                "group": "build"
            },
            {
                "label": "Clean",
                "type": "shell",
                "command": "bash ./build.sh clean",
                "problemMatcher": []
            },
            {
                "label": "Deploy Debug",
                "type": "shell",
                "command": "curl -T bin/debug/Silinium.sprx --ftp-create-dirs ftp://${config:consoleIp}/dev_hdd0/tmp/SprxLoader/BLES01031/Silinium.sprx",
                "dependsOn": "Build Debug",
                "problemMatcher": []
            },
            {
                "label": "Deploy Release",
                "type": "shell",
                "command": "curl -T bin/release/Silinium.sprx --ftp-create-dirs ftp://${config:consoleIp}/dev_hdd0/tmp/SprxLoader/BLES01031/Silinium.sprx",
                "dependsOn": "Build Release",
                "problemMatcher": []
            },
            {
                // Be careful with ftp commands since they run with root privileges.
                // This only creates or replaces files on the console.
                "label": "[GSC] Deploy scripts",
                "type": "shell",
                "command": "bash -c \"find tmp/Silinium -type f -exec curl --ftp-create-dirs -T '{}' 'ftp://${config:consoleIp}/dev_hdd0/{}' ';'\"",
                "problemMatcher": []
            }
        ]
    },
    "extensions": {
        "recommendations": [
            "ms-vscode.cpptools"
        ]
    }
}
